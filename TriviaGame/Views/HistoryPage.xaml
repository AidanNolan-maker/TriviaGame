<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TriviaGame.Views.HistoryPage"
    Title="Quiz History">
    
    
    <VerticalStackLayout
        Padding="30"
        Spacing="20"
        VerticalOptions="Center">
        
        <Label 
            Text="Quiz History"
            FontSize="32"
            FontAttributes="Bold" 
            HorizontalOptions="Center" />

        <Label
            Text="Your previous quiz results will appear here."
            FontSize="18"
            HorizontalOptions="Center" />
        
    </VerticalStackLayout>
    
</ContentPage>