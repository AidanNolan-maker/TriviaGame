<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="TriviaGame.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:TriviaGame.ViewModels"
    x:DataType="viewModels:MainViewModel"
    Title="Trivia Game">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="25"
            VerticalOptions="Center">

            <Label
                Text="Trivia Game"
                FontSize="36"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Test your knowledge!"
                FontSize="18"
                HorizontalOptions="Center" />

            <Button
                Text="Start Quiz"
                Command="{Binding StartQuizCommand}"
                HeightRequest="55" />

            <Button
                Text="Quiz History"
                Command="{Binding ViewHistoryCommand}"
                HeightRequest="55" />
        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>